# PostgreSQL қосылымы. Railway-да: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres@localhost:5432/fizika

# Платформа иесі (бас әкімші). Бірінші іске қосуда бір рет жасалады.
# Құпиясөз кемінде 10 таңба болсын; кейін оны сайттағы «Құпиясөз» бетінен ауыстырыңыз.
ADMIN_LOGIN=owner
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Платформа иесі

# Жүктелген файлдар. Railway-да томды (Volume) /data жолына бекітіп, /data/uploads деп беріңіз.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
# Файлдарды қайда сақтау: disk (UPLOAD_DIR) немесе db (дерекқорда; тегін Render үшін).
# Render-де әдепкі мән — db.
FILE_STORAGE=disk

PORT=3000
NODE_ENV=development

# Сыртқы (public) Postgres URL арқылы қосылсаңыз ғана:
# PGSSL=1
